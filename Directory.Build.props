<Project>
  <PropertyGroup>
    <!-- Enables the latest .NET code analysis features -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed so IDE0005 (unnecessary usings) is reported in the build, not just in the IDE -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Automatically installs StyleCop to all projects in the solution -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  
    <!-- Links the single stylecop.json file from the solution root to all projects -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>