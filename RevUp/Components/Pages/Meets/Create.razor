@page "/meets/create"
@rendermode InteractiveServer
@inject IMeetService MeetService
@inject NavigationManager Navigation

<PageTitle>Neues Meet – RevUp</PageTitle>

<h1 class="page-title">Neues Meet</h1>

<EditForm EditContext="_validation.EditContext" OnSubmit="SubmitAsync">
    <MeetForm Draft="_draft" Themes="_themes">
        <button type="submit" class="btn-primary">Meet erstellen</button>
    </MeetForm>
</EditForm>

@code {
    private readonly MeetDraft _draft = new();
    private ServerValidation _validation = null!;
    private IReadOnlyList<string> _themes = [];

    protected override async Task OnInitializedAsync()
    {
        _validation = new ServerValidation(_draft);
        _themes = MeetFilter.ThemesOf(await MeetService.GetUpcomingMeetsAsync());
    }

    private async Task SubmitAsync()
    {
        var result = await MeetService.CreateAsync(_draft);
        if (result.Succeeded)
        {
            Navigation.NavigateTo("/meets");
            return;
        }

        _validation.Show(result.Errors);
    }
}
