@page "/meets/{Id:guid}/anfragen"
@rendermode InteractiveServer
@inject IMeetService MeetService
@inject IMeetSubject MeetChanges
@implements IMeetObserver
@implements IDisposable

<PageTitle>Anfragen – RevUp</PageTitle>

<div class="subheader">
    <a class="back-btn" href="meets/@Id" aria-label="Zurück zum Meet"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></a>
    <span class="subheader-title">@(_details?.Title ?? "Meet")</span>
</div>

<h1 class="page-title">Anfragen</h1>

@if (_loaded && _details is null)
{
    <p class="empty-state">Dieses Meet gibt es nicht mehr.</p>
}
else if (_details is not null)
{
    <p class="hint">@_details.AttendeeCount / @_details.MaxAttendees Plätze belegt</p>

    @if (_message is not null)
    {
        <p class="validation-message" role="alert">@_message</p>
    }

    @if (_pending.Count == 0)
    {
        <p class="empty-state">Keine offenen Anfragen.</p>
    }
    else
    {
        <ul class="request-list">
            @foreach (var request in _pending)
            {
                <li class="request-row" @key="request.Id">
                    <span class="request-name">@request.ParticipantName</span>
                    <span class="request-time">seit @request.CreatedAt.ToString("HH:mm", System.Globalization.CultureInfo.GetCultureInfo("de-CH"))</span>
                    <button type="button" class="decision-btn reject" aria-label="@($"{request.ParticipantName} ablehnen")" disabled="@_busy" @onclick="() => DecideAsync(request.Id, false)">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="decision-btn approve" aria-label="@($"{request.ParticipantName} annehmen")" disabled="@_busy" @onclick="() => DecideAsync(request.Id, true)">
                        <i class="fa-solid fa-check" aria-hidden="true"></i>
                    </button>
                </li>
            }
        </ul>
    }
}

@code {
    private MeetDetails? _details;
    private IReadOnlyList<JoinRequestItem> _pending = [];
    private bool _loaded;
    private bool _busy;
    private string? _message;

    [Parameter]
    public Guid Id { get; set; }

    public async Task OnMeetChangedAsync(Guid meetId)
    {
        if (meetId != Id)
        {
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // Because a closed browser tab can be notified once more before Dispose detaches it.
        }
    }

    public void Dispose() => MeetChanges.Detach(this);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loaded = true;
        MeetChanges.Attach(this);
    }

    private async Task LoadAsync()
    {
        _details = await MeetService.GetMeetDetailsAsync(Id);
        _pending = await MeetService.GetPendingRequestsAsync(Id);
    }

    private async Task DecideAsync(Guid requestId, bool approve)
    {
        _busy = true;
        var decision = await MeetService.DecideAsync(requestId, approve);
        _message = decision switch
        {
            DecisionStatus.Full => "Das Meet ist voll. Gib zuerst einen Platz frei oder lehne die Anfrage ab.",
            DecisionStatus.NotFound => "Diese Anfrage wurde bereits bearbeitet.",
            _ => null,
        };
        await LoadAsync();
        _busy = false;
    }
}
