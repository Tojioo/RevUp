@page "/"
@page "/meets"
@rendermode InteractiveServer
@inject IMeetService MeetService
@inject IMeetSubject MeetChanges
@implements IMeetObserver
@implements IDisposable

<PageTitle>Entdecken – RevUp</PageTitle>

<h1 class="page-title">Entdecken</h1>

<div class="segmented visibility-filter" role="radiogroup" aria-label="Sichtbarkeit">
    @foreach (var (visibility, label) in _visibilities)
    {
        <button type="button" role="radio" class="segment @(_filter.Visibility == visibility ? "active" : "")"
                aria-checked="@(_filter.Visibility == visibility ? "true" : "false")"
                @onclick="() => SetFilter(_filter with { Visibility = visibility })">
            @label
        </button>
    }
</div>

<div class="chip-row">
    <button type="button" class="chip @(_filter.Theme is null ? "active" : "")" @onclick="() => SetFilter(_filter with { Theme = null })">Alle</button>
    @foreach (var theme in _themes)
    {
        <button type="button"
                class="chip @(string.Equals(theme, _filter.Theme, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                @onclick="() => SetFilter(_filter with { Theme = theme })">
            @theme
        </button>
    }
</div>

@if (_filteredMeets.Count == 0)
{
    <p class="empty-state">@(_meets.Count == 0 ? "Noch keine kommenden Meets." : "Keine Meets für diesen Filter.")</p>
}
else
{
    <div class="card-list">
        @foreach (var meet in _filteredMeets)
        {
            <a class="meet-link" href="meets/@meet.Id" @key="meet.Id">
                <article class="meet-card">
                    <div class="badge-row">
                        <span class="badge @(meet.IsPublic ? "badge-public" : "badge-private")">
                            @meet.VisibilityLabel
                        </span>
                        <span class="badge badge-theme">@meet.Theme</span>
                    </div>

                    <h2 class="meet-title">@meet.Title</h2>

                    <div class="meta-row">
                        <span class="meta-item"><i class="fa-regular fa-calendar" aria-hidden="true"></i> @meet.TimeWindow</span>
                        <span class="meta-item"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> @meet.LocationHint</span>
                    </div>

                    <div class="meet-foot">
                        <span class="meta-item @(meet.FreeSeats == 0 ? "seats-full" : "")"><i class="fa-solid fa-users" aria-hidden="true"></i> @meet.AttendeeCount/@meet.MaxAttendees · @meet.SeatsLabel</span>
                    </div>
                </article>
            </a>
        }
    </div>
}

@code {
    private static readonly (VisibilityFilter Visibility, string Label)[] _visibilities =
    [
        (VisibilityFilter.All, "Alle"),
        (VisibilityFilter.Public, "Öffentlich"),
        (VisibilityFilter.Private, "Privat"),
    ];

    private IReadOnlyList<MeetListItem> _meets = [];
    private IReadOnlyList<string> _themes = [];
    private MeetFilter _filter = new();
    private IReadOnlyList<MeetListItem> _filteredMeets = [];

    public async Task OnMeetChangedAsync(Guid meetId)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // Because a closed browser tab can be notified once more before Dispose detaches it.
        }
    }

    public void Dispose() => MeetChanges.Detach(this);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        MeetChanges.Attach(this);
    }

    private async Task LoadAsync()
    {
        _meets = await MeetService.GetUpcomingMeetsAsync();
        _themes = MeetFilter.ThemesOf(_meets);
        if (_filter.Theme is not null && !_themes.Contains(_filter.Theme, StringComparer.OrdinalIgnoreCase))
        {
            // Because the last meet of the chosen theme may just have ended or been removed while the page was open.
            _filter = _filter with { Theme = null };
        }

        _filteredMeets = _filter.Apply(_meets);
    }

    private void SetFilter(MeetFilter filter)
    {
        _filter = filter;
        _filteredMeets = _filter.Apply(_meets);
    }
}